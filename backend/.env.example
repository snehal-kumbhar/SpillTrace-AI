# SpillTrace AI - Environment Configuration
PROJECT_NAME="SpillTrace AI"
API_V1_STR="/api/v1"
SECRET_KEY="demo-secret-key-change-in-production"
ENVIRONMENT="development"
DEBUG=True

# Database (Default: SQLite for zero-prerequisite development)
# For production PostGIS: postgresql://user:password@localhost:5432/spilltrace_gis
DATABASE_URL="sqlite:///./spilltrace.db"

# CORS Origins
BACKEND_CORS_ORIGINS=["http://localhost:5173","http://localhost:3000","http://127.0.0.1:5173"]

# Scientific & AI Service Flags
USE_MOCK_MODELS=True
SENTINEL_API_KEY=""
SPIRE_AIS_API_KEY=""
CMEMS_USER=""
CMEMS_PASSWORD=""
